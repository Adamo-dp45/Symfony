        "openspout/openspout": "^5.13",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.4.1",
        "ramsey/uuid": "^4.9.4",
        "scheb/2fa-bundle": "^8.7",
        "scheb/2fa-email": "^8.7",
        "scheb/2fa-totp": "^8.7",
        "scheb/2fa-trusted-device": "^8.7",
        "stripe/stripe-php": "^21.3.3",
        "symfony/apache-pack": "*",
        "symfony/asset": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.7",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/twilio-notifier": "8.1.*",
        "symfony/ux-autocomplete": "^2.36.2",
        "symfony/ux-chartjs": "^2.36",
        "symfony/ux-live-component": "^2.36",
        "symfony/ux-native": "^2.36",
