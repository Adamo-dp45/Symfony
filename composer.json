        "symfony/ux-turbo": "^2.36",
        "symfony/ux-twig-component": "^2.36",
        "symfony/ux-typed": "^2.36",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4.3",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/reset-password-bundle": "^1.26.1",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/cache-extra": "^3.28",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/markdown-extra": "^3.29",
        "twig/string-extra": "^3.24",
        "twig/twig": "^2.12|^3.30",
        "vich/uploader-bundle": "^2.10.1",
        "webonyx/graphql-php": "^15.39",
        "zenstruck/messenger-monitor-bundle": "^0.6.0",
        "zircote/swagger-php": "^5.8.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Damo\\RecaptchaBundle\\": "libs/RecaptchaBundle"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "phpunit/phpunit": "^12.5.43",
        "rector/rector": "^2.8.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/panther": "^2.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zenstruck/foundry": "^2.16"
    }
}
