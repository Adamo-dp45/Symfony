        "intervention/image-symfony": "^1.3.1",
        "jzonta/faker-restaurant": "^2.0",
        "karser/karser-recaptcha3-bundle": "^0.3",
        "knplabs/knp-paginator-bundle": "^6.11",
        "knpuniversity/oauth2-client-bundle": "^2.20.2",
        "lcobucci/jwt": "^5.6.1",
