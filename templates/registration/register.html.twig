{% extends 'base.html.twig' %}

{% block title %}Inscription | Symfony{% endblock %}

{% block body %}
<div class="container">
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1>Inscription</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.username) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Password'
        }) }}
        {{ form_row(registrationForm.agreeTerms) }}
        <div class="mb-3">
            {{ form_row(registrationForm.captcha) }}
        </div>

        {# <puzzle-captcha -- Ex pour le faire à la main
            width="350"
            height="200"
            piece-width="80"
            piece-height="50"
            src="{{ path('captcha', {challenge: challenge}) }}"
        >
            <input type="text">
        </puzzle-captcha> #}

    {{ form_end(registrationForm) }}

    {#
        {{ form_row(registrationForm.password.first) }}
        {{ form_row(registrationForm.password.second) }}
    #}
</div>
{% endblock %}
