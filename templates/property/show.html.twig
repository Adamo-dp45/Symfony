{% extends 'base.html.twig' %}

{% block title %}{{ property.title }}{% endblock %}

{# -- La librairie le fait automatiquemnt
#}

{% block body %}
<style>
    .slider {
        width: 80%;
        margin: 0 auto;
    }

    .slider img {
        width: 100%;
        height: auto;
        border-radius: 10px;
    }

    .custom-arrows {
        text-align: center;
        margin-top: 10px;
    }

    .custom-arrows button {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        margin: 5px;
    }

    .custom-arrows button:hover {
        background-color: #45a049;
    }
</style>
<div class="jumbotron">
    <div class="container">

        {% if not form.vars.valid %}
            <div class="alert alert danger">
                Veuiller remplir le formulaire
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-8">
                <div data-slider>
                    {% for picture in property.pictures %}
                    <img src="{{ vich_uploader_asset(picture, 'imageFile') }}" class="card-img-top" style="width: 100%; height: auto;" alt="">
                    {% endfor %}
                </div>
                <div class="custom-arrows">
                    <button id="slick-prev">Précédent</button>
                    <button id="slick-next">Suivant</button>
                </div>
            </div>
            <div class="col-md-4">
                <h1>{{ property.title }}</h1>
                <h2>{{ property.rooms }} pièces - {{ property.surface }} m²</h2>
                <div class="text-primary" style="font-size: 4rem; font-weight: bold;">{{ property.price | number_format(0, '', ' ') }} FCFA</div>
                <button id="contactForm" class="btn btn-primary" {% if form.vars.submitted %}style="display: none;"{% endif %}>Contacter l'agence</button>
                <div id="form" class="mt-4" {% if not form.vars.submitted %}style="display: none;"{% endif %}>
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col">{{ form_row(form.firstname) }}</div>
                        <div class="col">{{ form_row(form.lastname) }}</div>
                    </div>
                    <div class="row">
                        <div class="col">{{ form_row(form.phone) }}</div>
                        <div class="col">{{ form_row(form.email) }}</div>
                    </div>
                    {{ form_rest(form) }}
                    <div class="form-group">
                        <button class="btn btn-primary">Envoyer</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container mt-4">
    <p>
        {{ property.description | nl2br }}
    </p>
    <div class="row">
        <div class="col-md-8">
            <h2>Caractéristiques</h2>
            <table class="table table-striped">
                <tr>
                    <td>Surface Habitable</td>
                    <td>{{ property.surface }} m²</td>
                </tr>
                <tr>
                    <td>Pièces</td>
                    <td>{{ property.rooms }}</td>
                </tr>
                <tr>
                    <td>Chambres</td>
                    <td>{{ property.bedrooms }}</td>
                </tr>
                <tr>
                    <td>Etage</td>
                    <td>{{ property.floor }}</td>
                </tr>
                <tr>
                    <td>Chauffage</td>
                    <td>...</td> <!--property.heatType-->
                </tr>
            </table>
        </div>
        <div class="col-md-4">
            <h2>Spécialités</h2>
            <ul class="list-group">
                {% for option in property.options %}
                <li class="list-group-item">{{ option.name }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <h2 class="mb-3">Carte géographique</h2>
    <div id="mapShow"
        class="mb-3"
        data-lat="{{ property.latitude }}"
        data-lng="{{ property.longitude }}"
        data-text="{{ property.title }}"
        style="width: 100%; height: 400px;"
    >
    </div>

    <div class="nav nav-tabs" id="tab"></div>
</div>

{% endblock %}
