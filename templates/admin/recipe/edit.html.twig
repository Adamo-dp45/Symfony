{% extends 'admin/base.html.twig' %}

{% block title %}{{ recipe.title }} | Symfony{% endblock %}

{% block body %}
<div class="container">
    <h1>{{ recipe.title }}</h1>
    <p>
        <img src="{{ vich_uploader_asset(recipe, 'thumbnailFile') }}" width="500px" height="auto" alt="">
    </p>

    <turbo-frame id="recipe_{{ recipe.id }}"> {#
            - L'action du formulaire est nécéssaire pour 'turbo-frame'
        #}
        {{ form_start(form, {action: path('admin.recipe.edit', {id: recipe.id})}) }}
        {# (form, { attr: { 'data-turbo': 'false' } }) -- Pour désactiver turbo sur le formulaire #}
        {# form_theme form 'form/form_theme.html.twig' -- !! utiliser un theme #}
        <div class="d-flex gap-1">
            {{ form_row(form.title) }}
            {{ form_row(form.duration) }}
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </turbo-frame>
</div>
{% endblock %}
