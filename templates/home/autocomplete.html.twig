{% extends 'base.html.twig' %}

{% block title %}Autocomplétion{% endblock %}

{% block body %}
<style>
    .search-wrapper {
        width: 100%;
        max-width: 520px;
    }

    h1 {
        font-size: 1.4rem;
        color: #1e293b;
        margin-bottom: 20px;
        font-weight: 600;
    }

    /* --- Conteneur relatif pour positionner la liste sous l'input --- */
    .autocomplete-container {
        position: relative;
    }

    .autocomplete-input {
        width: 100%;
        padding: 12px 42px 12px 16px;
        font-size: 1rem;
        border: 2px solid #cbd5e1;
        border-radius: 10px;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
        color: #1e293b;
    }

    .autocomplete-input:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }

    /* Icône loupe */
    .search-icon {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }

    /* Spinner de chargement */
    .spinner {
        display: none;
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        border: 2px solid #e2e8f0;
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    .spinner.visible { display: block; }

    @keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }

    /* --- Liste de suggestions --- */
    .autocomplete-list {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        overflow: hidden;
        z-index: 100;
        max-height: 300px;
        overflow-y: auto;
    }

    .autocomplete-list.open { display: block; }

    .autocomplete-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        cursor: pointer;
        color: #334155;
        font-size: 0.95rem;
        text-decoration: none;
        transition: background 0.15s;
        border-bottom: 1px solid #f1f5f9;
    }

    .autocomplete-item:last-child { border-bottom: none; }

    .autocomplete-item:hover,
    .autocomplete-item.active {
        background: #f0f4ff;
        color: #4f46e5;
    }

    /* Mise en valeur du terme recherché */
    .autocomplete-item mark {
        background: none;
        color: #6366f1;
        font-weight: 700;
    }

    .no-result {
        padding: 14px 16px;
        color: #94a3b8;
        font-size: 0.9rem;
        font-style: italic;
    }
</style>

<div class="search-wrapper">
    <h1>🔍 Recherche de produits</h1>

    <div class="autocomplete-container" id="autocomplete">
        <input
            type="text"
            class="autocomplete-input"
            id="searchInput"
            placeholder="Tapez au moins 2 caractères..."
            autocomplete="off"
            aria-autocomplete="list"
            aria-controls="suggestionList"
            aria-expanded="false"
        />

        <svg class="search-icon" id="searchIcon" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>

        <div class="spinner" id="spinner"></div>

        <div class="autocomplete-list" id="suggestionList" role="listbox"></div>
    </div>
</div>

<script>
(function () {
    const input       = document.getElementById('searchInput');
    const list        = document.getElementById('suggestionList');
    const spinner     = document.getElementById('spinner');
    const searchIcon  = document.getElementById('searchIcon');

    // URL de l'endpoint Symfony (générée côté serveur)
    const ENDPOINT = '{{ path('autocomplete.search') }}';

    let debounceTimer = null;
    let currentIndex  = -1;
    let suggestions   = [];
    let abortController = null;

    // --- Debounce : attend 300ms après la dernière frappe avant d'appeler l'API ---
    input.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        const query = input.value.trim();

        if (query.length < 2) {
            closeList();
            return;
        }

        debounceTimer = setTimeout(() => fetchSuggestions(query), 300);
    });

    // --- Navigation clavier (flèches + Entrée + Échap) ---
    input.addEventListener('keydown', (e) => {
        const items = list.querySelectorAll('.autocomplete-item');

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            currentIndex = Math.min(currentIndex + 1, items.length - 1);
            highlightItem(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            currentIndex = Math.max(currentIndex - 1, -1);
            highlightItem(items);
        } else if (e.key === 'Enter' && currentIndex >= 0) {
            e.preventDefault();
            items[currentIndex]?.click();
        } else if (e.key === 'Escape') {
            closeList();
        }
    });

    // Ferme la liste si on clique ailleurs
    document.addEventListener('click', (e) => {
        if (!document.getElementById('autocomplete').contains(e.target)) {
            closeList();
        }
    });

    // --- Appel API avec annulation de la requête précédente (AbortController) ---
    async function fetchSuggestions(query) {
        if (abortController) abortController.abort();
        abortController = new AbortController();

        showSpinner(true);

        try {
            const url = `${ENDPOINT}?q=${encodeURIComponent(query)}`;
            const res = await fetch(url, { signal: abortController.signal });

            if (!res.ok) throw new Error('Erreur réseau');

            suggestions = await res.json();
            renderList(suggestions, query);
        } catch (err) {
            if (err.name !== 'AbortError') {
                console.error('Autocomplétion :', err);
            }
        } finally {
            showSpinner(false);
        }
    }

    // --- Affiche les suggestions dans la liste ---
    function renderList(items, query) {
        list.innerHTML = '';
        currentIndex = -1;

        if (items.length === 0) {
            list.innerHTML = `<p class="no-result">Aucun résultat pour « ${escapeHtml(query)} »</p>`;
        } else {
            items.forEach((item, i) => {
                const a = document.createElement('a');
                a.className  = 'autocomplete-item';
                a.href       = item.url;
                a.setAttribute('role', 'option');
                a.setAttribute('data-index', i);
                a.innerHTML  = `📦 ${highlight(item.label, query)}`;
                list.appendChild(a);
            });
        }

        list.classList.add('open');
        input.setAttribute('aria-expanded', 'true');
    }

    // --- Met en surbrillance le terme recherché dans le label ---
    function highlight(text, query) {
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return escapeHtml(text).replace(
            new RegExp(`(${escaped})`, 'gi'),
            '<mark>$1</mark>'
        );
    }

    function escapeHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function highlightItem(items) {
        items.forEach((el, i) => {
            el.classList.toggle('active', i === currentIndex);
        });
    }

    function closeList() {
        list.classList.remove('open');
        list.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
        currentIndex = -1;
    }

    function showSpinner(show) {
        spinner.classList.toggle('visible', show);
        searchIcon.style.display = show ? 'none' : '';
    }
})();
</script>
{% endblock %}