{% extends 'base.html.twig' %}

{% block title %}Accueil | Symfony{% endblock %}

{% block javascripts %}
<script>
    const url = new URL('http://localhost:3000/.well-known/mercure') // L'url vers le hub
    url.searchParams.append('topic', 'http://monsite.com/ping') // Les topic qu'on vas écoutés, peut être  simplement une url en dur mais on vas pouvoir utiliser un sytème de templates avec un params {id} qui permettra d'écouter plusieurs urls
    url.searchParams.append('topic', 'http://monsite.com/user/{id}') // --

    const eventSource = new EventSource(url, {
        withCredentials: true, // 'withCredentials' pour la partie permet d'envoyer les cookies

        /* headers: { -- Pour les spa et mobiles
            Authorization: 'Jwt mercure'
        } */
    })
    eventSource.onmessage = (e) => { // On écoute lorsqu'on reçoit un message
        console.log(
            e.data // Pour récupérer les données de l'évènement
        )
        let message = 'Ping !'
        // -- Pour la partie user
        const data = JSON.parse(e.data)
        if(data.username) {
            message = `Ping par ${data.username} !`
        }
     
        // --
        document.querySelector('.ping').insertAdjacentHTML('afterend', `<div class="alert alert-success">${message}</div>`)
        window.setTimeout(() => {
            const $alert = document.querySelector('.alert')
            $alert.parentNode.removeChild($alert)
        }, 2000)
    }
</script>
{% endblock %}


{% block body %}
<div class="bg-light p-5 mb-5 text-center">
    <div class="container">
