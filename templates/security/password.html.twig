{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe | Symfony{% endblock %}

{% block body %}
<div class="container">
    <h1>Nouveau mot de passe</h1>
    <form method="post">
        <div class="form-group">
            <label for="password">Nouveau mot de passe :</label>
            <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success mt-2">Réinitialiser</button>
    </form>
</div>
{% endblock %}